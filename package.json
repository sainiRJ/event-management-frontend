{
  "name": "event-management-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@craco/craco": "^7.1.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@reduxjs/toolkit": "^2.5.0",
    "@rsuite/icons": "^1.3.0",
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "firebase": "^11.4.0",
    "joi": "^17.13.3",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.509.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^4.12.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.30.0",
    "react-scripts": "5.0.1",
    "recharts": "^2.15.1",
    "redux-logger": "^3.0.6",
    "redux-react-hook": "^4.0.3",
    "rsuite": "^5.76.3",
    "sonner": "^2.0.3",
    "ts-loader": "^9.5.2"
  },
  "scripts": {
    "postinstall": "husky install",
    "check-types": "tsc --noemit",
    "run-eslint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint": "npm run run-eslint && npm run check-types",
    "format": "prettier --check \"src/**/*.ts\"",
    "start": "cross-env  PORT=8090 BROWSER=none craco start",
    "build": "craco build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "prepare": "husky install"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@emotion/eslint-plugin": "^11.12.0",
    "@types/joi": "^17.2.2",
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/redux-logger": "^3.0.13",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^2.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.4.1",
    "prettier": "^2.5.0",
    "typescript": "^4.9.5"
  }
}
