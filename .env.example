# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Never put a secret here - anything in this file ships to every visitor.

VITE_EVENT_MANAGEMENT_BACKEND_BASEURL=http://localhost:3080/api
VITE_EVENT_MANAGEMENT_API_SERVER_TIMEOUT=15000

# Socket.IO server for real-time notifications.
VITE_SOCKET_URL=http://localhost:3080

# Google OAuth. Only the public client id belongs here - the client SECRET
# lives in the backend, which performs the code exchange.
VITE_GOOGLE_CLIENT_ID=
VITE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# AI chat service, for reading chat transcripts
VITE_CHAT_SERVICE_BASEURL=http://localhost:4080/api
